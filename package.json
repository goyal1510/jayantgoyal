{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:auth": "playwright test --config tests/auth/playwright.config.ts",
    "test:auth:list": "playwright test --config tests/auth/playwright.config.ts --list",
    "test:auth:read-only": "playwright test --config tests/auth/playwright.config.ts --grep @read-only"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.1",
      "react-dom": "^19.2.1"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  }
}
