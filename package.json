{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "analyze:portfolio": "ANALYZE=true pnpm --filter portfolio exec next build --webpack",
    "analyze:portfolio:static": "ANALYZE=true ANALYZE_OPEN=false pnpm --filter portfolio exec next build --webpack",
    "analyze:portfolio:turbopack": "pnpm --filter portfolio exec next experimental-analyze",
    "analyze:all:turbopack": "pnpm --filter portfolio exec next experimental-analyze --output && pnpm --filter studio exec next experimental-analyze --output && pnpm --filter admin exec next experimental-analyze --output && pnpm --filter auth exec next experimental-analyze --output",
    "build": "turbo run build",
    "check:bundle-budgets": "pnpm --filter studio build && pnpm analyze:all:turbopack && node scripts/check-bundle-budgets.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "check:service-role": "node scripts/check-service-role-boundaries.mjs",
    "db:migrations:apply": "node scripts/supabase/migration-workflow.mjs --apply",
    "db:migrations:check": "node scripts/supabase/migration-workflow.mjs --check",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:db:linked": "node scripts/verify-database-boundaries.mjs",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "prettier": "^3.6.0",
    "turbo": "^2.6.1",
    "vercel": "^56.3.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "dompurify@3.4.0": "3.4.12",
      "flatted@3.3.3": "3.4.2",
      "minimatch@3.1.2": "3.1.5",
      "minimatch@9.0.5": "9.0.9",
      "minimatch@10.1.1": "10.2.5",
      "next": "^16.2.10",
      "path-to-regexp@8.2.0": "8.4.2",
      "path-to-regexp@8.3.0": "8.4.2",
      "picomatch@2.3.1": "2.3.2",
      "postcss@8.4.31": "8.5.19",
      "postcss@8.5.6": "8.5.19",
      "prismjs@1.27.0": "1.30.0",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "tar@7.5.7": "7.5.20",
      "ws@8.18.3": "8.21.1"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
