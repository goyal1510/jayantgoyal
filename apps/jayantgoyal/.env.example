# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (for auth redirects, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portfolio data source: "database" to fetch from Supabase, omit for hardcoded default
# PORTFOLIO_DATA_SOURCE=database

# Email (Resend) — required for contact form
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# record_only or send
COMMERCE_EMAIL_DELIVERY_MODE=record_only
COMMERCE_SUPPORT_EMAIL=

# Commerce / payments — Razorpay is the active India-compatible provider
COMMERCE_PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional Stripe fallback only. Do not use for this project unless account geography is resolved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
COMMERCE_STRIPE_MODE=test

# OpenWeather API — required for weather app
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# GitHub — required for GitHub Stats page and portfolio Code Stats section
GITHUB_TOKEN=

# Note: Guest login uses Supabase Anonymous Sign-In
# No guest credentials needed — enable "Anonymous Sign-ins" in Supabase Dashboard > Authentication > Providers
