NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for administrative actions (do not expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Portfolio data source: "database" to fetch from Supabase, omit or leave empty for system default
# PORTFOLIO_DATA_SOURCE=database

# Note: Guest login now uses Supabase Anonymous Sign-In
# No guest credentials needed - enable "Anonymous Sign-ins" in Supabase Dashboard > Authentication > Providers
