# Commerce / payments — server-side admin catalog and reporting only
COMMERCE_PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional Stripe fallback only. Do not use for this project unless account geography is resolved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
COMMERCE_STRIPE_MODE=test
