SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Storage hostname. Derived from SUPABASE_URL by default.
SUPABASE_STORAGE_URL=
MEDIA_STORAGE_BUCKET=media-converter-output
MEDIA_POLL_SECONDS=3
MEDIA_RETENTION_MINUTES=60
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_MAX_OUTPUT_BYTES=524288000

# Optional Netscape-format cookies.txt encoded as one base64 string.
# Use only an account authorized to access the submitted private media.
YOUTUBE_COOKIES_BASE64=
LOG_LEVEL=INFO
PORT=8080
