# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (for auth redirects, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001

# OpenWeather API — required for weather app
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# GitHub — required for the GitHub Stats product
GITHUB_TOKEN=

# Note: Guest login uses Supabase Anonymous Sign-In
# No guest credentials needed — enable "Anonymous Sign-ins" in Supabase Dashboard > Authentication > Providers
