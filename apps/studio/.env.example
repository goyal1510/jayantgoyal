# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# platform is the shared cross-application session mode; legacy remains an
# emergency rollback value only.
NEXT_PUBLIC_AUTH_SESSION_MODE=platform
# Optional `.localhost` or `.test` parent for local cross-subdomain testing. Leave empty in Vercel.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Auth owns sign-in and account security; Studio has no local settings sheet.
# This flag controls only login/account handoff ownership, not a settings implementation.
NEXT_PUBLIC_AUTH_FLOW_OWNER=auth
NEXT_PUBLIC_AUTH_URL=http://localhost:3003

# Site URL (for auth redirects, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001

# OpenWeather API — required for weather app
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# GitHub — required for the GitHub Stats product
GITHUB_TOKEN=

# Note: Guest login uses Supabase Anonymous Sign-In
# No guest credentials needed — enable "Anonymous Sign-ins" in Supabase Dashboard > Authentication > Providers
