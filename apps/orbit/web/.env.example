# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# platform is the shared cross-application session mode; legacy remains an
# emergency rollback value only.
NEXT_PUBLIC_AUTH_SESSION_MODE=platform
# Optional `.localhost` or `.test` parent for local cross-subdomain testing. Leave empty in Vercel.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Auth is the canonical sign-in, MFA, and account-security owner.
NEXT_PUBLIC_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_ORBIT_URL=http://localhost:3004
# Server-only: signs outbound webhook deliveries and verifies inbound integration calls.
ORBIT_INBOUND_WEBHOOK_SECRET=
# Optional: refreshes linked GitHub issue title/state from the API.
GITHUB_TOKEN=
# Optional: sends workspace invitation emails from the outbox worker.
RESEND_API_KEY=
ORBIT_INVITE_FROM=Orbit <onboarding@resend.dev>
# Server-only: required for export/import workers, webhook delivery, and API token routes.
SUPABASE_SERVICE_ROLE_KEY=
