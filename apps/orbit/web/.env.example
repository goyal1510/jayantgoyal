# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# platform is the shared cross-application session mode; legacy remains an
# emergency rollback value only.
NEXT_PUBLIC_AUTH_SESSION_MODE=platform
# Optional `.localhost` or `.test` parent for local cross-subdomain testing. Leave empty in Vercel.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Auth is the canonical sign-in, MFA, and account-security owner.
NEXT_PUBLIC_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_ORBIT_URL=http://localhost:3004
