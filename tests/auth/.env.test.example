# Optional external targets. Set both or neither.
AUTH_TEST_MAIN_BASE_URL=
AUTH_TEST_ADMIN_BASE_URL=

# Authenticated tests never run unless this is exactly true.
AUTH_TEST_ALLOW_AUTHENTICATED=false
AUTH_TEST_CROSS_HOST=false

# Disposable normal-user persona.
AUTH_TEST_USER_EMAIL=
AUTH_TEST_USER_PASSWORD=
AUTH_TEST_USER_TOTP_SECRET=

# Disposable non-admin persona used against Admin denial.
AUTH_TEST_NON_ADMIN_EMAIL=
AUTH_TEST_NON_ADMIN_PASSWORD=

# Disposable Admin/Super Admin persona with a verified TOTP factor.
AUTH_TEST_ADMIN_EMAIL=
AUTH_TEST_ADMIN_PASSWORD=
AUTH_TEST_ADMIN_TOTP_SECRET=
